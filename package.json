{
  "name": "fashion-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "prisma:deploy": "npx prisma db push --schema=backend/prisma/schema.prisma --accept-data-loss",
    "start": "node --max-old-space-size=400 backend/dist/index.js"
  }
}