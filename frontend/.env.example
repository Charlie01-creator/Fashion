# Base URL of the deployed backend API, including the /api prefix.
# Local dev: the Express server run by `npm run dev:backend`.
# Production: your Render/Railway service URL, e.g.
#   https://fashion-platform-api.onrender.com/api
# Must be set as a real environment variable in the Vercel project settings —
# NEXT_PUBLIC_* vars are baked in at build time, so changing this requires a
# redeploy, not just an env var update on a running instance.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
