# --- Server ---
NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed to make credentialed
# (cookie-carrying) requests to this API. No trailing slashes, no wildcards.
# Local dev: the Next.js dev server's origin.
# Production: your Vercel production domain, plus any preview/staging
# domains you actually need (each preview deploy gets its own URL, so this
# is a maintained allowlist, not automatic — see DEPLOYMENT.md).
CLIENT_ORIGIN=http://localhost:3000

# --- Database (Neon) ---
# Neon gives you TWO connection strings on your project's dashboard —
# Dashboard → your project → Connect. Both are required, and they serve
# different purposes:
#
# DATABASE_URL — the POOLED connection (hostname contains "-pooler"). Used
#   by the running app for normal query traffic. Pooling matters even for a
#   long-running backend (not just serverless) because Neon's free tier caps
#   concurrent direct connections, and pooling avoids exhausting that cap.
#
# DIRECT_URL — the UNPOOLED / direct connection (no "-pooler" in the
#   hostname). Used ONLY by Prisma Migrate (`prisma migrate dev`,
#   `prisma migrate deploy`) — PgBouncer's transaction pooling mode doesn't
#   support the session-level operations Migrate needs, so migrations must
#   bypass the pooler.
#
# Both must include `?sslmode=require` — Neon requires SSL, unlike the local
# Postgres default below.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/fashion_platform?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/fashion_platform?sslmode=require
# Local dev without Neon (e.g. Docker Postgres) only needs DATABASE_URL —
# DIRECT_URL can be omitted entirely, or set to the same value:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fashion_platform?schema=public

# --- Auth ---
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# --- Refresh-token cookie ---
# "lax" is correct for local dev (frontend and backend are different ports
# on localhost, which browsers treat as same-site for cookie purposes).
#
# PRODUCTION: if frontend (e.g. Vercel) and backend (e.g. Render/Railway)
# are on different domains — the default for this stack — you MUST set:
#   COOKIE_SAMESITE=none
# otherwise the browser will silently refuse to send the refresh cookie on
# cross-site requests (login will appear to work, but refresh-on-reload and
# logout will not — see docs/ARCHITECTURE.md).
COOKIE_SAMESITE=lax
# Leave unset to use the default (false in dev, true in production).
# COOKIE_SECURE=true
# Only set if frontend and backend share a registrable domain
# (e.g. app.example.com / api.example.com). Leave unset for
# *.vercel.app / *.onrender.com / *.up.railway.app deployments.
# COOKIE_DOMAIN=

# --- Logging ---
LOG_LEVEL=info

# --- Storage ---
# NOTE: STORAGE_DRIVER only supports "local" today, which writes to disk on
# the backend's own filesystem. Render/Railway (and most PaaS) filesystems
# are EPHEMERAL — anything written here is wiped on every redeploy, restart,
# or scale event. Fine for local dev; do not treat uploaded images as
# durable in production until an S3-backed StorageProvider is implemented
# (see backend/src/services/storage/ and docs/ARCHITECTURE.md). This is a
# known, flagged limitation, not something this pass fixes — the auth/deploy
# reliability work here is scoped separately from that feature build-out.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads
MAX_UPLOAD_SIZE_MB=5

# --- AI service ---
AI_PROVIDER=mock
AI_MOCK_LATENCY_MS=600
AI_MOCK_FAILURE_RATE=0.1
AI_REQUEST_TIMEOUT_MS=20000
# Only needed when AI_PROVIDER=openai_vision:
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
