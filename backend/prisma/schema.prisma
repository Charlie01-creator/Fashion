// ============================================================================
// Fashion Platform — Database Schema
// ============================================================================
// Phase 1 implements: User, UserProfile, RefreshToken.
// Everything else below is intentionally NOT created as a table yet.
// It's documented here so the schema doubles as a living architecture doc
// and so future migrations extend a shape that's already been thought through,
// rather than being bolted on ad hoc.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon-specific: DATABASE_URL should be the pooled (PgBouncer) connection
  // string for normal app traffic. Prisma Migrate (migrate dev/deploy) needs
  // a direct, unpooled connection — PgBouncer's transaction pooling mode
  // doesn't support the session-level features Migrate relies on. DIRECT_URL
  // is only read by the Prisma CLI at generate/migrate time, never by the
  // running app, so it does not need to go through backend/src/config/env.ts.
  // See DEPLOYMENT.md → "Neon-specific setup" for where to get each value.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// CORE — Phase 1
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       UserProfile?
  refreshTokens RefreshToken[]
  clothingItems ClothingItem[]
  outfits       Outfit[]
  outfitRecommendations OutfitRecommendation[]
  outfitFeedback        OutfitFeedback[]
  styleProfile          StyleProfile?
  fashionPreference     UserFashionPreference?

  @@map("users")
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  stylePreferences  String[] @default([])
  favouriteColors   String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Enables refresh-token revocation (logout, "log out everywhere", stolen-token
// mitigation) — the thing pure stateless JWT can't give you.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// WARDROBE — Phase 2
// ---------------------------------------------------------------------------

// Images are NEVER stored in Postgres. `imageUrl` points at a file in the
// storage backend (local disk in dev, S3/blob storage in prod) — see
// backend/src/services/storage/. This keeps the DB small and fast to back
// up, and keeps large binary traffic off the connection pool entirely.
model ClothingItem {
  id     String @id @default(uuid())
  userId String

  imageUrl String // public URL (or CDN URL) resolved by the storage provider
  imageKey String // storage-internal key, needed to delete the underlying file

  category String // top | bottom | outerwear | footwear | accessory | dress | other
  color    String
  style    String? // e.g. "minimalist", "streetwear" — free text for now, taxonomy later
  season   String // spring | summer | autumn | winter | all_season

  tags String[] @default([])

  // Reserved for the AI phase (vision-model output: fabric, pattern, fit).
  // NEVER settable directly by the client — see validators/clothing.validator.ts.
  aiMetadata Json?

  // Tracks the AI analysis pipeline independently of aiMetadata's content,
  // so the frontend can render "queued" / "analyzing…" / "failed, retry"
  // states without guessing from aiMetadata being null (which is ambiguous:
  // null could mean "not analyzed yet" or "analysis ran and found nothing").
  //   PENDING    — item created, queued for analysis, not yet started
  //   ANALYZING  — actively being processed by the AI provider right now
  //   COMPLETED  — aiMetadata holds a successful result
  //   FAILED     — analysis attempted and failed; aiErrorMessage explains why; retriable
  aiStatus       String    @default("PENDING")
  // Safe-for-display failure reason, set only when aiStatus is FAILED.
  // Full technical error detail goes to the server log (see clothingService),
  // never here — this field is shown directly to the user.
  aiErrorMessage String?
  aiAnalyzedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]

  // Composite indexes: every real query in this app filters by userId first
  // (ownership is mandatory, never optional), then optionally narrows by
  // category or color. A standalone index on `color` or `category` alone
  // would have poor selectivity across the whole table and Postgres's
  // planner wouldn't use it once userId is always in the WHERE clause —
  // so these are userId-led composites, not single-column indexes.
  @@index([userId, category])
  @@index([userId, color])
  @@index([userId, createdAt])
  @@index([userId, aiStatus])
  @@map("clothing_items")
}

// ---------------------------------------------------------------------------
// OUTFITS — Phase 3 (AI Outfit Recommendation Engine)
// ---------------------------------------------------------------------------

// Represents one call to the recommendation engine — the inputs that
// produced a batch of Outfit candidates (occasion, weather, and a snapshot
// of style preferences at generation time). Kept separate from Outfit
// itself because one generation request produces several outfit
// candidates, and because UserProfile.stylePreferences can change after
// the fact — the snapshot here preserves *why* an outfit was generated the
// way it was, even if the user's stated preferences later change.
model OutfitRecommendation {
  id     String @id @default(uuid())
  userId String

  occasion                 String // casual | formal | party | work | wedding
  weatherContext           Json? // structure only this phase — see shared WeatherContext type
  stylePreferencesSnapshot Json? // copy of UserProfile.stylePreferences/favouriteColors at generation time

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfits Outfit[]

  @@index([userId, createdAt])
  @@map("outfit_recommendations")
}

// A single generated (or, later, manually assembled) outfit. Deliberately
// holds NO clothing details of its own — color, category, image, etc. all
// live on ClothingItem and are reached through OutfitItem. This is the
// "do not duplicate clothing information" requirement: an Outfit is a
// pointer structure (which items, in what role, why) over data that
// already exists, not a copy of it. If the underlying ClothingItem changes
// (or gets re-analyzed by AI), every Outfit referencing it reflects that
// automatically — there's nothing to keep in sync.
model Outfit {
  id               String @id @default(uuid())
  userId           String
  recommendationId String?

  occasion         String // same vocabulary as OutfitRecommendation.occasion
  reasoning        String // why these specific items work together
  styleExplanation String // the style/aesthetic read on the combination
  confidence       Float // 0–1, engine's confidence in this combination

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting the recommendation batch (if that ever
  // becomes a user-facing action) shouldn't delete outfits the user has
  // since saved/kept — only sever the "generated as part of" link.
  recommendation OutfitRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  items          OutfitItem[]
  feedback       OutfitFeedback[]

  @@index([userId, createdAt])
  @@index([userId, occasion])
  @@index([recommendationId])
  @@map("outfits")
}

// Join table between Outfit and ClothingItem — this is what "reference
// existing ClothingItems" without duplication actually means structurally.
model OutfitItem {
  id             String  @id @default(uuid())
  outfitId       String
  clothingItemId String
  // Which slot this item fills in the outfit (top, bottom, outerwear,
  // footwear, accessory, dress, other) — lets the frontend render outfits
  // in a sensible visual order without re-deriving it from category.
  role           String?

  outfit       Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  // Cascade here means: if the user deletes a ClothingItem that's part of a
  // saved outfit, that item's slot silently disappears from the outfit
  // rather than blocking the deletion or deleting the whole outfit. This is
  // a deliberate trade-off, not an oversight — see docs/ARCHITECTURE.md for
  // the reasoning and what a more complete version of this would do
  // (mark the outfit "incomplete" and prompt the user to replace the slot).
  clothingItem ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  // Prevents the same clothing item from being added to one outfit twice.
  @@unique([outfitId, clothingItemId])
  @@index([clothingItemId])
  @@map("outfit_items")
}

// ---------------------------------------------------------------------------
// STYLE INTELLIGENCE — Phase 4 (Personal Style DNA + feedback loop)
// ---------------------------------------------------------------------------

// One row per user (1:1, enforced by @unique on userId) — a cached,
// point-in-time computation, not a log. Regenerated on demand via
// POST /style-profile/generate, not recalculated on every read; see
// services/style/style.service.ts for why (cost vs. freshness trade-off).
model StyleProfile {
  id     String @id @default(uuid())
  userId String @unique

  dominantStyle String
  // Full StyleProfileData payload — stylePercentages, favouriteColors,
  // preferredCategories, recommendedImprovements. Kept as one JSON blob
  // rather than normalized columns because this is a derived, disposable
  // computation (safe to regenerate from source data at any time), not a
  // primary record — normalizing it would add migration overhead for a
  // shape that's expected to evolve as the analyzer improves.
  styleData Json

  confidenceScore Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("style_profiles")
}

// Explicit, user-declared preferences — distinct from StyleProfile, which
// is *inferred* from behavior. This is what the user says about
// themselves; StyleProfile is what their wardrobe and choices say. Both
// feed the recommendation engine; keeping them separate means a user's
// stated preference is never silently overwritten by an inferred one.
model UserFashionPreference {
  id     String @id @default(uuid())
  userId String @unique

  preferredStyles String[] @default([])
  dislikedStyles  String[] @default([])
  favoriteColors  String[] @default([])
  // Free-form map, e.g. { "work": ["classic","business"] } — not enum-
  // constrained like ClothingOccasion/OutfitOccasion because this is the
  // user's own nuance about what they personally mean by an occasion,
  // not a taxonomy the rest of the system needs to agree on.
  occasionPreferences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_fashion_preferences")
}

// Append-only event log, NOT a toggle table — a user can WORN the same
// outfit repeatedly (each wear is a real, separate signal worth counting),
// and a LIKE followed later by a DISLIKE on the same outfit is meaningful
// history, not something to overwrite. "Current" sentiment (e.g. for a
// like/dislike button's UI state) is derived by reading the most recent
// LIKE/DISLIKE row per outfit, computed in outfit.service.ts — not stored
// as a separate mutable flag that could drift from the log.
model OutfitFeedback {
  id       String @id @default(uuid())
  userId   String
  outfitId String
  action   String // LIKE | DISLIKE | SAVED | WORN

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfit Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  // [userId, createdAt]: the recommendation engine's feedback-weighting
  // query reads "this user's recent feedback, newest first" — see
  // services/style/style.service.ts#getItemFeedbackScores.
  // [outfitId]: computing one outfit's feedback summary for its DTO.
  // [userId, action]: aggregate queries like "this user's liked outfits".
  @@index([userId, createdAt])
  @@index([outfitId])
  @@index([userId, action])
  @@map("outfit_feedback")
}

